# PostgreSQL (Контент-Завод 2.0)
# Для Docker: DATABASE_URL и NC_DB собираются из POSTGRES_PASSWORD в docker-compose — задайте один пароль ниже.
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/content_factory

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_KEY=./secrets/google-sa-key.json
# Рабочая таблица (один канал / legacy). Не подставлять сюда же ID шаблона.
SPREADSHEET_ID=1abc...xyz
# Отдельная эталонная таблица для онбординга и create-client-table — ДРУГОЙ ID, не копировать из SPREADSHEET_ID.
TEMPLATE_SPREADSHEET_ID=
# Папка Drive, куда класть копии таблиц клиентов. ID из URL: drive.google.com/drive/folders/FOLDER_ID
# Если копирует только SA: владелец файла = SA → квоты нет → storageQuotaExceeded даже в вашей папке. Тогда либо Shared drive (Workspace) + SA в участниках, либо OAuth ниже.
GOOGLE_DRIVE_CLIENT_TABLES_FOLDER_ID=
# Копирование шаблона от имени пользователя с квотой (OAuth Desktop client + refresh token). Все три переменные вместе.
# Scope: https://www.googleapis.com/auth/drive — шаблон и папка должны быть доступны этому Google-аккаунту.
GOOGLE_DRIVE_COPY_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_COPY_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_COPY_OAUTH_REFRESH_TOKEN=
# Google Email админа — всегда выдаётся доступ к новым таблицам клиентов (writer)
ADMIN_GOOGLE_EMAIL=

# OpenRouter
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_GROUNDING_MODEL=perplexity/sonar
OPENROUTER_TEXT_MODEL=deepseek/deepseek-chat
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
# Транскрибация голоса/видео в онбординге (модель с input_audio)
OPENROUTER_TRANSCRIPTION_MODEL=google/gemini-2.5-flash

# Яндекс Wordstat (через Директ)
YANDEX_OAUTH_TOKEN=y0_...
YANDEX_WORDSTAT_CLIENT_ID=abc123

# Beget S3 (эндпоинт из панели Beget: Объектное хранилище → Настройки)
S3_ENDPOINT=https://s3.ru1.storage.beget.cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ba368d4f4852-content-factory-images

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHANNEL_ID=@nursery_channel
TELEGRAM_NOTIFY_CHAT_ID=123456789
# Кто может жать «Присвоить OpenRouter ключ» под уведомлением о новом клиенте (numeric user id, через запятую). Узнать id: @userinfobot. Пусто = любой участник чатов из TELEGRAM_NOTIFY_CHAT_ID.
TELEGRAM_ADMIN_USER_IDS=

# Redis — обязателен для работы (очереди BullMQ, состояние публикаций). Без запущенного Redis приложение не стартует. Для Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# NocoDB (админка поверх БД). В Docker NC_DB задаётся в compose из POSTGRES_PASSWORD — в .env можно не указывать.
# Локальный запуск NocoDB без compose: pg://localhost:5432?u=user&p=password&d=content_factory
NC_DB=pg://localhost:5432?u=user&p=password&d=content_factory
# Секрет JWT (обязательно сменить на проде)
NC_AUTH_JWT_SECRET=change-me-in-production
# Опционально: SMTP для приглашений и сброса пароля. Без них в логах будет "Email Plugin not configured / active" — это нормально.
# NC_SMTP_FROM=noreply@example.com
# NC_SMTP_HOST=smtp.example.com
# NC_SMTP_PORT=587
# NC_SMTP_USERNAME=
# NC_SMTP_PASSWORD=
# NC_SMTP_SECURE=false

# HTTP API веб-онбординга (POST /api/onboarding). Без ONBOARDING_API_SECRET API не запускается.
API_PORT=3100
ONBOARDING_API_SECRET=
# За Caddy/nginx: доверять X-Forwarded-* (rate limit по реальному клиенту). Не включать, если 3100 открыт в интернет без прокси.
# TRUST_PROXY=1

# HTTPS через Caddy (docker compose --profile https up -d). DNS A этой записи → IP VPS; порты 80/443 открыть на фаерволе.
# Публичный URL онбординга: https://bot.ex-ai.pro/api/onboarding (пример прод-домена)
# CADDY_DOMAIN=bot.ex-ai.pro

# Синхронизация листа «Настройки» → БД для мульти-клиента на каждом цикле планировщика. Отключить: 1
# DISABLE_SHEET_SETTINGS_SYNC=1

# Расписание и retry
POLL_INTERVAL_MS=60000
MAX_ARTICLES_PER_DAY=10
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000
# Таймаут запросов к OpenRouter, мс (защита от зависания; по умолчанию 120000)
OPENROUTER_TIMEOUT_MS=120000

# Prisma seed: клиент id=default создаётся при первом seed; повторный seed его не меняет.
# Осознанно подтянуть default из .env (не включать в CI без нужды):
# SEED_SYNC_DEFAULT_CLIENT=1
# Опционально вместе с ним: SEED_DEFAULT_CLIENT_ACTIVE=1 или =0 (вкл/выкл isActive у default)
