{
  "name": "content-factory",
  "version": "1.0.0",
  "description": "Контент-Завод: генерация статей из ключевых слов, публикация в Telegram/Дзен",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:./node_modules/* && npx esbuild prisma/seed.ts --bundle --platform=node --target=node20 --outfile=dist/seed.js --external:./node_modules/*",
    "build:tsc": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "hide-rows": "ts-node src/scripts/hideRows.ts",
    "export-client": "ts-node cli/export-client.ts",
    "create-client-table": "ts-node cli/create-client-table.ts",
    "clear-client-stats": "ts-node scripts/clear-client-stats.ts",
    "seed:dev": "ts-node prisma/seed.ts",
    "db:seed": "npm run build && prisma db seed",
    "backfill-niche": "npx esbuild scripts/backfill-niche.ts --bundle --platform=node --target=node20 --outfile=dist/backfill-niche.js --external:./node_modules/* && node dist/backfill-niche.js",
    "backfill-niche:dry": "npx esbuild scripts/backfill-niche.ts --bundle --platform=node --target=node20 --outfile=dist/backfill-niche.js --external:./node_modules/* && node dist/backfill-niche.js --dry-run",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@fastify/bearer-auth": "^10.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "^6.19.2",
    "ajv-formats": "^3.0.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.2",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.1",
    "openai": "^4.104.0",
    "p-limit": "^7.3.0",
    "sharp": "^0.33.5",
    "telegraf": "^4.16.3"
  },
  "overrides": {
    "bullmq": {
      "ioredis": "$ioredis"
    },
    "fast-xml-parser": "5.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "esbuild": "^0.25.12",
    "prisma": "^6.19.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "node dist/seed.js"
  }
}
